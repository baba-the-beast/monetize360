# Copy to .env. Never commit .env.
# Owner account - used only by Postgres itself to create the schema.
POSTGRES_USER=m360
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=monetize360
# App account - limited rights, subject to Row-Level Security (deploy/postgres/init/001_roles.sh)
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://m360_app:change-me-app@postgres:5432/monetize360
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=info
KEY_CACHE_TTL_SECONDS=60
PACK_POLL_SECONDS=10
# JSON Schema for packs, read by control/schema.py (never by the engine)
PACK_SCHEMA_PATH=/app/packs/schema/pack.schema.json
